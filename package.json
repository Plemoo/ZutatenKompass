{
  "name": "zutatenkompass",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo/vector-icons": "^15.1.1",
    "expo": "~57.0.12",
    "expo-constants": "~57.0.10",
    "expo-dev-client": "~57.0.11",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.12",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "jest-expo": "^57.0.4",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "versions":"git tag --sort=-v:refname",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "validate:data": "node scripts/validate-catalog.mjs",
    "generate:data": "node scripts/generate-catalog.mjs",
    "check": "pnpm validate:data && pnpm typecheck && pnpm lint && pnpm test"
  },
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.13"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  }
}
