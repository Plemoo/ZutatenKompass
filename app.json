{
  "expo": {
    "name": "Zutaten Kompass",
    "slug": "zutatenkompass",
    "version": "1.0.2",
    "orientation": "portrait",
    "scheme": "zutatenkompass",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zutatenkompass"
    },
    "android": {
      "package": "com.zutatenkompass",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-image",
      "expo-sqlite"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6b28e585-3546-42c7-874d-68220183b9fa"
      }
    }
  }
}
